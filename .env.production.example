# ==============================================================================
# AGRI GLOBAL MARKETPLACE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production and provide high-entropy secrets.
# NEVER commit .env.production to source control!

# --- General Server & Networking ---
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://agriglobal.example.com
BASE_URL=https://agriglobal.example.com

# --- Database (MongoDB 7.0+) ---
# For Atlas, replace with: mongodb+srv://<user>:<password>@cluster.mongodb.net/agri_marketplace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/agri_marketplace

# --- Security & JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_cryptographic_random_string_in_production
JWT_EXPIRES_IN=7d

# --- AI & ML Microservice ---
AI_SERVICE_URL=http://127.0.0.1:8000

# --- Payment Gateway (Razorpay India & International) ---
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_configured_webhook_secret
PLATFORM_COMMISSION_PERCENT=5

# --- Currency & FX Rates ---
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/INR

# --- Storage & File Uploads ---
# 'disk' stores images in /uploads; 'gridfs' stores directly in MongoDB GridFS (recommended for ephemeral cloud disks like Render/Heroku)
UPLOAD_STORAGE=disk
UPLOAD_DIR=uploads

# --- Rate Limiting & Anti-Abuse ---
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=300
PAYMENT_RATE_LIMIT_MAX=600

# --- Multi-Channel Notification Transports ---
# SMTP Email Transport (Optional - simulated if empty)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
FROM_EMAIL=notifications@agriglobal.example.com

# SMS Transport (Twilio or Fast2SMS - simulated if empty)
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=AGRIGLOBAL
